# The one environment file, for local development. It holds development defaults only (no
# secrets), so it is committed and there is nothing to copy. Docker Compose and Nx load it
# by name; the API, the import and Prisma read it through their config.

# Host ports used by Docker Compose. Change these if they clash with something on your machine.
WEB_PORT=8090
DB_PORT=5544

POSTGRES_USER=finder
POSTGRES_PASSWORD=finder
POSTGRES_DB=product_finder

# Used by `nx serve api`, the import CLI and `npm run db:*` outside Docker.
DATABASE_URL=postgresql://finder:finder@localhost:5544/product_finder
API_PORT=3100
# Reviews accepted per client IP per minute.
REVIEW_RATE_LIMIT=5
# Number of reverse proxies in front of the API; 0 when it is reached directly.
TRUST_PROXY=0
