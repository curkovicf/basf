{
  "name": "product-finder",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Product Finder: an Nx monorepo with the NestJS API, the catalogue import CLI and the Angular web app.",
  "scripts": {
    "start": "npm run finder:dev",
    "finder:api": "nx serve api --watch",
    "finder:api:debug": "nx serve api --watch --inspect",
    "finder:web": "nx serve finder",
    "finder:dev": "npm run kill:dev && docker compose up -d --wait db && nx run-many -t serve -p api finder",
    "kill:dev": "for p in 3100 4200; do for pid in $(lsof -ti tcp:$p -sTCP:LISTEN 2>/dev/null); do case $(ps -p $pid -o comm=) in *com.docker*) echo \"port $p is published by a Docker container (docker ps): stop it to free the port\";; *) kill -9 $pid 2>/dev/null;; esac; done; done; pkill -f \"dist/apps/api/main.js\" 2>/dev/null; pkill -f \"bin/nx run-many -t serve\" 2>/dev/null; pkill -f \"bin/nx serve (api|finder)\" 2>/dev/null; true",
    "finder:import": "nx run catalog-import:run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "nx run catalog-import:run",
    "build:all": "nx run-many -t build",
    "lint:all": "nx run-many -t lint && prettier --check \"libs/**/*.{ts,html}\" \"apps/**/*.{ts,html}\" --ignore-path .prettierignore",
    "format": "prettier --write \"libs/**/*.{ts,html,scss}\" \"apps/**/*.{ts,html,scss}\" --ignore-path .prettierignore",
    "test:all": "nx run-many -t test",
    "test:int": "nx e2e api-e2e",
    "generate:lib": "node scripts/generate-library.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^12.1.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@primeuix/themes": "^3.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.3",
    "helmet": "^8.3.0",
    "joi": "^18.0.0",
    "pg": "^8.23.1",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.5",
    "@angular-devkit/schematics": "^22.2.5",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@nx/angular": "23.2.0",
    "@nx/devkit": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/jest": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/node": "23.2.0",
    "@nx/webpack": "23.2.0",
    "@nx/workspace": "23.2.0",
    "@schematics/angular": "^22.2.5",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.8",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "angular-eslint": "^22.2.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.2.0",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "ts-node": "10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.29.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  }
}
